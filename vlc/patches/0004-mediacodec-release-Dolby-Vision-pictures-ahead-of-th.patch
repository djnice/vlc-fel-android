From 00e426d4ed09f711e79037a66dbc3148d3486171 Mon Sep 17 00:00:00 2001
Message-ID: <00e426d4ed09f711e79037a66dbc3148d3486171.1791362188.git.djnice@freemail.hu>
From: djnice <djnice@freemail.hu>
Date: Wed, 7 Oct 2026 10:36:27 +0200
Subject: [PATCH] mediacodec: release Dolby Vision pictures ahead of their time

The vout prepares a picture only a few ms before its date, so the release
time snapped between the vsyncs (dvfp_snap_present_ns) was mostly in the
past already: SurfaceFlinger showed the frame as soon as it could, and the
vsync it landed in depended on the phase of VLC's clock to the display
(random per start or seek; near SurfaceFlinger's latch two frames ended up
in one vsync, a drop). Dolby Vision pictures are now dated 80 ms earlier and
released for their real time, which is then always 40-85 ms ahead.

Message-Id: <20261007-dvfel-mediacodec-dovi-release-ahead@djnice>

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 modules/codec/omxil/mediacodec.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/modules/codec/omxil/mediacodec.c b/modules/codec/omxil/mediacodec.c
index 47841beaa2..ba6bf69493 100644
--- a/modules/codec/omxil/mediacodec.c
+++ b/modules/codec/omxil/mediacodec.c
@@ -92,6 +92,16 @@ static struct
     int64_t (*present_lead_ns)(const dvfp *); /* optional */
 } dvfp_api;
 
+/*
+ * The vout prepares a picture only a few ms before its date; the release
+ * time snapped between the vsyncs (dvfp_snap_present_ns) is then mostly in
+ * the past already, and the vsync SurfaceFlinger shows the frame in depends
+ * on when it was queued (repeats and drops when that is near its latch).
+ * Dolby Vision pictures are therefore dated this much earlier and released
+ * for their real time: always ahead of it.
+ */
+#define DOVI_RELEASE_AHEAD VLC_TICK_FROM_MS(80)
+
 static void DoviLoadOnce(void)
 {
     void *lib = dlopen("libdvfelplay.so", RTLD_NOW);
@@ -1014,7 +1024,7 @@ static void ReleasePictureTs(decoder_t *p_dec, unsigned i_index, vlc_tick_t i_ts
     /* Dolby Vision decoder: render times between the display's vsyncs, so
      * that clock jitter never puts two frames into one vsync (a drop) */
     if (p_sys->video.b_dovi && dvfp_api.snap_present_ns)
-        i_ns = dvfp_api.snap_present_ns(i_ns);
+        i_ns = dvfp_api.snap_present_ns(i_ns + DOVI_RELEASE_AHEAD * INT64_C(1000));
     p_sys->api.release_out_ts(&p_sys->api, i_index, i_ns);
 }
 
@@ -1103,6 +1113,10 @@ static int Video_ProcessOutput(decoder_t *p_dec, mc_api_out *p_out,
          * module holds the composed frame back to its time */
         if (p_sys->video.b_dovi && p_sys->video.p_dvfp && dvfp_api.present_lead_ns)
             p_pic->date -= dvfp_api.present_lead_ns(p_sys->video.p_dvfp) / 1000;
+        /* released ahead (DOVI_RELEASE_AHEAD, added back in ReleasePictureTs) */
+        if (p_sys->video.b_dovi && dvfp_api.snap_present_ns
+         && p_sys->api.b_direct_rendering && p_sys->api.release_out_ts)
+            p_pic->date -= DOVI_RELEASE_AHEAD;
         p_pic->b_progressive = true;
 
         if (p_sys->api.b_direct_rendering)
