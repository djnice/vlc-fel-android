 static inline bool MP4_TrackGetPTSDelta( demux_t *p_demux, const mp4_track_t *p_track,
                                          vlc_tick_t *pi_delta )
 {
@@ -714,12 +746,251 @@ static block_t * MP4_Block_Convert( demux_t *p_demux, const mp4_track_t *p_track
     return p_block;
 }
 
+/*****************************************************************************
+ * Dolby Vision dual track (profile 7 Blu-ray remuxes): the enhancement layer
+ * (EL and RPU) is a track of its own (dvhe/dvh1, a quarter of the base
+ * layer's size). Its samples are merged into the base layer's samples the
+ * way single track files carry them: every EL NAL unit wrapped in a NAL unit
+ * of type 63, the RPU (type 62) last.
+ *****************************************************************************/
+static int TrackTimeToSampleChunk( demux_t *, mp4_track_t *, vlc_tick_t,
+                                   uint32_t *, uint32_t * );
+static int TrackGotoChunkSample( demux_t *, mp4_track_t *, unsigned int, unsigned int );
+
+static unsigned DVNalLengthSize( const es_format_t *p_fmt )
+{
+    if( p_fmt->i_extra < 23 )
+        return 0;
+    return ( ((const uint8_t *)p_fmt->p_extra)[21] & 0x03 ) + 1;
+}
+
+static void DVSetupDualTrack( demux_t *p_demux )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+
+    for( unsigned i = 0; i < p_sys->i_tracks; i++ )
+    {
+        mp4_track_t *p_el = &p_sys->track[i];
+        if( !p_el->b_ok || p_el->b_chapters_source || p_el->fmt.i_cat != VIDEO_ES ||
+            !p_el->p_sample || !DVNalLengthSize( &p_el->fmt ) ||
+            ( p_el->p_sample->i_type != VLC_FOURCC( 'd', 'v', 'h', 'e' ) &&
+              p_el->p_sample->i_type != VLC_FOURCC( 'd', 'v', 'h', '1' ) ) )
+            continue;
+
+        for( unsigned j = 0; j < p_sys->i_tracks; j++ )
+        {
+            mp4_track_t *p_bl = &p_sys->track[j];
+            if( j == i || !p_bl->b_ok || p_bl->b_chapters_source ||
+                p_bl->fmt.i_cat != VIDEO_ES || !p_bl->p_sample ||
+                !DVNalLengthSize( &p_bl->fmt ) ||
+                p_bl->fmt.video.i_width != 2 * p_el->fmt.video.i_width ||
+                p_bl->fmt.video.i_height != 2 * p_el->fmt.video.i_height )
+                continue;
+            switch( p_bl->p_sample->i_type )
+            {
+                case VLC_FOURCC( 'h', 'v', 'c', '1' ):
+                case VLC_FOURCC( 'h', 'e', 'v', '1' ):
+                case VLC_FOURCC( 'd', 'v', 'h', 'e' ):
+                case VLC_FOURCC( 'd', 'v', 'h', '1' ):
+                    break;
+                default:
+                    continue;
+            }
+
+            /* no ES and not demuxed on its own (like a chapters track), but
+             * selected so that its samples can be stepped through */
+            if( p_el->p_es )
+                es_out_Del( p_demux->out, p_el->p_es );
+            p_el->p_es = NULL;
+            p_el->b_chapters_source = true;
+            p_el->b_selected = true;
+            p_sys->dv.p_bl = p_bl;
+            p_sys->dv.p_el = p_el;
+            msg_Info( p_demux, "Dolby Vision dual track: enhancement layer track[Id 0x%x] "
+                      "%ux%u merged into track[Id 0x%x]", p_el->i_track_ID,
+                      p_el->fmt.video.i_width, p_el->fmt.video.i_height,
+                      p_bl->i_track_ID );
+            return;
+        }
+    }
+}
+
+/* the EL sample with the base layer sample's DTS (or NULL) */
+static block_t *DVReadEL( demux_t *p_demux, vlc_tick_t i_nzdts )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+    mp4_track_t *p_el = p_sys->dv.p_el;
+    const vlc_tick_t i_tolerance = VLC_TICK_FROM_MS(5);
+
+    /* after a seek (or at the start): from the sample before */
+    if( p_el->i_sample >= p_el->i_sample_count ||
+        MP4_TrackGetDTSUnclamped( p_demux, p_el ) > i_nzdts + i_tolerance ||
+        MP4_TrackGetDTSUnclamped( p_demux, p_el ) + VLC_TICK_FROM_SEC(2) < i_nzdts )
+    {
+        uint32_t i_chunk, i_sample;
+        p_el->b_selected = true;
+        if( TrackTimeToSampleChunk( p_demux, p_el, __MAX( i_nzdts, 0 ), &i_chunk, &i_sample ) ||
+            TrackGotoChunkSample( p_demux, p_el, i_chunk, i_sample ) )
+            return NULL;
+    }
+    while( p_el->i_sample < p_el->i_sample_count &&
+           MP4_TrackGetDTSUnclamped( p_demux, p_el ) + i_tolerance < i_nzdts )
+    {
+        if( MP4_TrackNextSample( p_demux, p_el, 1 ) )
+            return NULL;
+    }
+    if( p_el->i_sample >= p_el->i_sample_count ||
+        MP4_TrackGetDTSUnclamped( p_demux, p_el ) > i_nzdts + i_tolerance )
+        return NULL;
+
+    uint32_t i_nb_samples = 0;
+    uint32_t i_size = MP4_TrackGetReadSize( p_el, &i_nb_samples );
+    block_t *p_block = NULL;
+    if( i_size > 0 && i_nb_samples == 1 &&
+        MP4_Seek( p_demux->s, MP4_TrackGetPos( p_el ) ) == VLC_SUCCESS )
+        p_block = vlc_stream_Block( p_demux->s, i_size );
+    MP4_TrackNextSample( p_demux, p_el, 1 );
+    return p_block;
+}
+
+static uint8_t *DVPutNal( uint8_t *p, unsigned i_len_size, const uint8_t *p_nal,
+                          size_t i_nal, bool b_wrap )
+{
+    const size_t i_total = i_nal + (b_wrap ? 2 : 0);
+    for( unsigned k = 0; k < i_len_size; k++ )
+        *p++ = i_total >> (8 * (i_len_size - 1 - k));
+    if( b_wrap )
+    {
+        *p++ = 0x7E; /* NAL unit type 63, layer 0, temporal id 0 */
+        *p++ = 0x01;
+    }
+    memcpy( p, p_nal, i_nal );
+    return p + i_nal;
+}
+
+/* the VPS, SPS and PPS of a hvcC, wrapped (at most 32) */
+static uint8_t *DVPutParamSets( uint8_t *p, unsigned i_len_size, const es_format_t *p_fmt )
+{
+    const uint8_t *h = p_fmt->p_extra, *h_end = h + p_fmt->i_extra;
+    unsigned i_arrays = h[22], i_added = 0;
+
+    h += 23;
+    for( ; i_arrays > 0 && h + 3 <= h_end; i_arrays-- )
+    {
+        unsigned i_nalus = (h[1] << 8) | h[2];
+        h += 3;
+        for( ; i_nalus > 0 && h + 2 <= h_end; i_nalus-- )
+        {
+            const size_t i_len = (h[0] << 8) | h[1];
+            h += 2;
+            if( i_len > (size_t)(h_end - h) || i_added == 32 )
+                return p;
+            p = DVPutNal( p, i_len_size, h, i_len, true );
+            i_added++;
+            h += i_len;
+        }
+    }
+    return p;
+}
+
+/* the base layer sample with the enhancement layer appended */
+static block_t *DVMerge( demux_t *p_demux, block_t *p_bl )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+    const unsigned i_bl_len = DVNalLengthSize( &p_sys->dv.p_bl->fmt );
+    const unsigned i_el_len = DVNalLengthSize( &p_sys->dv.p_el->fmt );
+    const es_format_t *p_el_fmt = &p_sys->dv.p_el->fmt;
+
+    block_t *p_el = DVReadEL( p_demux, MP4_TrackGetDTSUnclamped( p_demux, p_sys->dv.p_bl ) );
+    if( !p_el )
+    {
+        if( p_sys->dv.i_missed++ % 100 == 0 )
+            msg_Warn( p_demux, "Dolby Vision dual track: no EL sample for dts %"PRId64
+                      " (%u merged, %u missed)", p_bl->i_dts, p_sys->dv.i_merged,
+                      p_sys->dv.i_missed );
+        return p_bl;
+    }
+
+    /* the EL's NAL units; parameter sets from its hvcC at IRAP pictures
+     * when the sample has none */
+    bool b_irap = false, b_ps = false;
+    size_t i_out = p_bl->i_buffer;
+    for( size_t i = 0; i + i_el_len <= p_el->i_buffer; )
+    {
+        size_t n = 0;
+        for( unsigned k = 0; k < i_el_len; k++ )
+            n = (n << 8) | p_el->p_buffer[i + k];
+        i += i_el_len;
+        if( n < 2 || n > p_el->i_buffer - i )
+            break;
+        const unsigned i_type = (p_el->p_buffer[i] >> 1) & 0x3f;
+        b_irap |= i_type >= 16 && i_type <= 21;
+        b_ps |= i_type >= 32 && i_type <= 34;
+        i_out += i_bl_len + 2 + n;
+        i += n;
+    }
+    bool b_add_ps = b_irap && !b_ps && p_el_fmt->i_extra > 23;
+    if( b_add_ps )
+        i_out += p_el_fmt->i_extra + 32 * (i_bl_len + 2);
+
+    block_t *p_out = block_Alloc( i_out );
+    if( !p_out )
+    {
+        block_Release( p_el );
+        return p_bl;
+    }
+    block_CopyProperties( p_out, p_bl );
+    memcpy( p_out->p_buffer, p_bl->p_buffer, p_bl->i_buffer );
+    uint8_t *p = p_out->p_buffer + p_bl->i_buffer;
+    const uint8_t *p_rpu = NULL;
+    size_t i_rpu = 0;
+
+    for( size_t i = 0; i + i_el_len <= p_el->i_buffer; )
+    {
+        size_t n = 0;
+        for( unsigned k = 0; k < i_el_len; k++ )
+            n = (n << 8) | p_el->p_buffer[i + k];
+        i += i_el_len;
+        if( n < 2 || n > p_el->i_buffer - i )
+            break;
+        const uint8_t *p_nal = &p_el->p_buffer[i];
+        const unsigned i_type = (p_nal[0] >> 1) & 0x3f;
+        i += n;
+
+        if( i_type == 62 )
+        {
+            p_rpu = p_nal;
+            i_rpu = n;
+            continue;
+        }
+        if( b_add_ps && i_type != 35 ) /* after the access unit delimiter */
+        {
+            p = DVPutParamSets( p, i_bl_len, p_el_fmt );
+            b_add_ps = false;
+        }
+        p = DVPutNal( p, i_bl_len, p_nal, n, true );
+    }
+    if( p_rpu )
+        p = DVPutNal( p, i_bl_len, p_rpu, i_rpu, false );
+    p_out->i_buffer = p - p_out->p_buffer;
+
+    if( p_sys->dv.i_merged++ == 0 )
+        msg_Info( p_demux, "Dolby Vision dual track: EL merged (%zu + %zu bytes, IRAP %d, "
+                  "in-band parameter sets %d)", p_bl->i_buffer, p_el->i_buffer, b_irap, b_ps );
+    block_Release( p_el );
+    block_Release( p_bl );
+    return p_out;
+}
+
 static void MP4_Block_Send( demux_t *p_demux, mp4_track_t *p_track, block_t *p_block )
 {
     p_block = MP4_Block_Convert( p_demux, p_track, p_block );
     if( p_block == NULL )
         return;
 
+    if( p_track == p_demux->p_sys->dv.p_bl && p_block->i_dts != VLC_TICK_INVALID )
+        p_block = DVMerge( p_demux, p_block );
+
     if ( p_track->i_chans_to_reorder )
     {
         aout_ChannelReorder( p_block->p_buffer, p_block->i_buffer,
@@ -1090,6 +1361,8 @@ static int Open( vlc_object_t * p_this )
         }
     }
 
+    DVSetupDualTrack( p_demux );
+
     p_mvex = MP4_BoxGet( p_sys->p_moov, "mvex" );
     if( p_mvex != NULL )
     {
@@ -1414,9 +1687,10 @@ static int DemuxTrack( demux_t *p_demux, mp4_track_t *tk, uint64_t i_readpos,
 
             /* dts */
             p_block->i_dts = VLC_TICK_0 + i_current_nzdts;
-            /* pts */
+            /* pts (from the decoding time before it was clamped at 0) */
             if( MP4_TrackGetPTSDelta( p_demux, tk, &i_delta ) )
-                p_block->i_pts = p_block->i_dts + i_delta;
+                p_block->i_pts = VLC_TICK_0 +
+                    __MAX( MP4_TrackGetDTSUnclamped( p_demux, tk ) + i_delta, 0 );
             else if( tk->fmt.i_cat != VIDEO_ES )
                 p_block->i_pts = p_block->i_dts;
             else
diff --git a/modules/demux/mpeg/ts.c b/modules/demux/mpeg/ts.c
index 6c8ad7d687..b8d32e5832 100644
--- a/modules/demux/mpeg/ts.c
+++ b/modules/demux/mpeg/ts.c
@@ -723,10 +723,11 @@ static int Demux( demux_t *p_demux )
                 MVCGatherDep( p_demux, p_pkt, i_header );
