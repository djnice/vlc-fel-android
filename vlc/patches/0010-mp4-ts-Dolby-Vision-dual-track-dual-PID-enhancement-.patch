     p_sys->mvc.b_no_hold = true;
-    ParsePESDataChain( p_demux, p_sys->mvc.p_held_pid, p_pes, p_sys->mvc.i_held_pcr );
+    ParsePESDataChain( p_demux, h.p_pid, h.p_pes, h.i_pcr );
     p_sys->mvc.b_no_hold = false;
 }
 
