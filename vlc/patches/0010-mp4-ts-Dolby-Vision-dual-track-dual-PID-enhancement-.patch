+/* A base view PES can be complete before its dependent view AU, which comes
+ * after it (and may be gathered only at the next dependent view PES start):
+ * then it waits for it, in order, with at most 7 others. true: held */
 static bool MVCHold( demux_t *p_demux, ts_pid_t *pid, block_t *p_pes,
                      ts_90khz_t i_append_pcr, ts_90khz_t i_dts )
 {
     demux_sys_t *p_sys = p_demux->p_sys;
+    const unsigned i_max = ARRAY_SIZE(p_sys->mvc.held);
 
     if( p_sys->mvc.b_no_hold )
         return false;
-    MVCReleaseHeld( p_demux );
-    if( i_dts == TS_90KHZ_INVALID )
-        return false;
-    /* there already, or the dependent view is ahead (.ssif) */
-    for( const block_t *p = p_sys->mvc.p_queue; p; p = p->p_next )
-        if( MVCDiff( p->i_dts, i_dts ) >= 0 )
+    if( !p_sys->mvc.i_held )
+    {
+        if( i_dts == TS_90KHZ_INVALID )
             return false;
-
-    p_sys->mvc.p_held = p_pes;
-    p_sys->mvc.p_held_pid = pid;
-    p_sys->mvc.i_held_pcr = i_append_pcr;
-    p_sys->mvc.i_held_dts = i_dts;
+        /* there already, or the dependent view is ahead (.ssif) */
+        for( const block_t *p = p_sys->mvc.p_queue; p; p = p->p_next )
+            if( MVCDiff( p->i_dts, i_dts ) >= 0 )
+                return false;
+    }
+    else if( p_sys->mvc.i_held == i_max )
+        MVCReleaseHeld( p_demux ); /* waited long enough */
+
+    p_sys->mvc.held[p_sys->mvc.i_held].p_pes = p_pes;
+    p_sys->mvc.held[p_sys->mvc.i_held].p_pid = pid;
+    p_sys->mvc.held[p_sys->mvc.i_held].i_pcr = i_append_pcr;
+    p_sys->mvc.held[p_sys->mvc.i_held].i_dts = i_dts;
+    p_sys->mvc.i_held++;
     return true;
 }
 
