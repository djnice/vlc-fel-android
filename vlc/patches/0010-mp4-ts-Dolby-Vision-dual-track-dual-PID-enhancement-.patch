     return MP4_rescale_mtime( sdts, p_track->i_timescale );
 }
 
+/* the decoding time before MP4_TrackTimeApplyELST() clamps it: negative for
+ * the first samples when the edit list skips the composition delay (the
+ * presentation times are computed from it) */
+static inline vlc_tick_t MP4_TrackGetDTSUnclamped( demux_t *p_demux, mp4_track_t *p_track )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+    const mp4_chunk_t *p_chunk = &p_track->chunk[p_track->i_chunk];
+
+    stime_t sdts = MP4_ChunkGetSampleDTS( p_chunk,
+                                          p_track->i_sample - p_chunk->i_sample_first );
+    if( p_track->p_elst && p_track->BOXDATA(p_elst)->i_entry_count )
+    {
+        const MP4_Box_data_elst_t *elst = p_track->BOXDATA(p_elst);
+        if( elst->i_media_time[p_track->i_elst] > 0 &&
+            ( elst->i_media_rate_integer[p_track->i_elst] > 0 ||
+              elst->i_media_rate_fraction[p_track->i_elst] > 0 ) )
+            sdts -= elst->i_media_time[p_track->i_elst];
+        sdts += MP4_rescale( p_track->i_elst_time, p_sys->i_timescale, p_track->i_timescale );
+    }
+    return MP4_rescale_mtime( sdts, p_track->i_timescale );
+}
