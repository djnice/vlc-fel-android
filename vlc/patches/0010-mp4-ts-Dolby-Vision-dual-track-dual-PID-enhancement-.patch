+/* a stream merged into another one by the demux: the 3D MVC dependent view
+ * (stream type 0x20) into the H.264 base view; a Dolby Vision enhancement
+ * layer (the Dolby Vision video stream descriptor without the base layer,
+ * giving the base layer's PID, or Ultra HD Blu-ray's HEVC 0x1015 next to the
+ * HEVC 0x1011) into the base layer */
+static void PMTSetupDependentPid( demux_t *p_demux, const dvbpsi_pmt_t *p_dvbpsipmt )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+    uint16_t i_mvc = 0, i_avc = 0, i_el = 0, i_bl = 0;
+    bool b_bd_bl = false, b_bd_el = false;
+
+    for( const dvbpsi_pmt_es_t *p_es = p_dvbpsipmt->p_first_es; p_es; p_es = p_es->p_next )
+    {
+        if( p_es->i_type == 0x20 && !i_mvc )
+            i_mvc = p_es->i_pid;
+        if( p_es->i_type == 0x1b && !i_avc )
+            i_avc = p_es->i_pid;
+        if( p_es->i_type == 0x24 )
+        {
+            b_bd_bl |= p_es->i_pid == 0x1011;
+            b_bd_el |= p_es->i_pid == 0x1015;
+        }
+        for( const dvbpsi_descriptor_t *p_dr = p_es->p_first_descriptor; p_dr; p_dr = p_dr->p_next )
+        {
+            if( p_dr->i_tag == 0xB0 && p_dr->i_length >= 6 &&
+                !(p_dr->p_data[3] & 0x01) /* bl_present_flag */ )
+            {
+                i_el = p_es->i_pid;
+                i_bl = (p_dr->p_data[4] << 5) | (p_dr->p_data[5] >> 3);
+            }
+        }
+    }
+    if( !i_el && b_bd_bl && b_bd_el )
+    {
+        i_el = 0x1015;
+        i_bl = 0x1011;
+    }
+
+    if( i_mvc )
+        ts_mvc_SetPids( p_demux, i_mvc, i_avc, false );
+    else if( i_el && i_bl )
+        ts_mvc_SetPids( p_demux, i_el, i_bl, true );
+    else if( i_avc && p_sys->mvc.i_dep_pid && !p_sys->mvc.b_dovi )
+        p_sys->mvc.i_base_pid = i_avc; /* .ssif: the base view's own PMT */
+}
