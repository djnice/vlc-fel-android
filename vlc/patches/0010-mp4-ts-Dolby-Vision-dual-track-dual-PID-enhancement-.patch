+void ts_mvc_SetPids( demux_t *p_demux, uint16_t i_dep, uint16_t i_base, bool b_dovi )
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+
+    if( i_dep == p_sys->mvc.i_dep_pid && b_dovi == p_sys->mvc.b_dovi &&
+        ( !i_base || i_base == p_sys->mvc.i_base_pid ) )
