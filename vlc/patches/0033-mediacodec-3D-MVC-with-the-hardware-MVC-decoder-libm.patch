+/*
+ * Hardware MVC as a MediaCodec api (mc_api): the decoder module runs as with
+ * MediaCodec (output thread, opaque pictures released at their time, flush,
+ * drain), libmvc3dplay's hardware path does the decoding and the display: the
+ * picture buffers go into a video tunnel shown by the surface's sideband stream.
+ */
+struct mvc_hw_sys
+{
+    mvc3d_hw *p_hw;
+    int i_width, i_height;
+    bool b_fp;
+    bool b_conf_sent;
+    atomic_bool b_flush;    /* dequeue_out returns (output thread: flush) */
+    atomic_bool b_eos;      /* drain: the decoder keeps its last pictures */
+    vlc_tick_t pi_pts[64];  /* by buffer index */
+};
+#define MVC_HW_EOS_INDEX 0x7ffe
+
+static struct mvc_hw_sys *MvcHwSys(mc_api *api)
+{
+    return (struct mvc_hw_sys *)api->p_sys;
+}
+
+static void MvcHw_Clean(mc_api *api)
+{
+    free(api->psz_name);
+    api->psz_name = NULL;
+    free(api->p_sys);
+    api->p_sys = NULL;
+}
+
+static int MvcHw_Configure(mc_api *api, int i_profile)
+{
+    VLC_UNUSED(i_profile);
+    api->i_quirks = 0;
+    api->b_support_rotation = false;
+    free(api->psz_name);
+    api->psz_name = strdup("mvc3d hardware");
+    return 0;
+}
+
+static int MvcHw_Start(mc_api *api, union mc_api_args *p_args)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+
+    if (!p_args->video.p_surface)
+        return MC_API_ERROR;
+    s->p_hw = mvc_api.hw_open(s->i_width, s->i_height, s->b_fp);
+    if (!s->p_hw)
+        return MC_API_ERROR;
+    if (mvc_api.hw_set_sideband(s->p_hw, p_args->video.p_surface))
+    {
+        mvc_api.hw_close(s->p_hw);
+        s->p_hw = NULL;
+        return MC_API_ERROR;
+    }
+    s->b_conf_sent = false;
+    atomic_store(&s->b_flush, false);
+    atomic_store(&s->b_eos, false);
+    api->b_started = true;
+    api->b_direct_rendering = true;
+    return 0;
+}
+
+static int MvcHw_Stop(mc_api *api)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+
+    if (s && s->p_hw)
+        mvc_api.hw_close(s->p_hw);
+    if (s)
+        s->p_hw = NULL;
+    api->b_started = false;
+    api->b_direct_rendering = false;
+    return 0;
+}
+
+static int MvcHw_Flush(mc_api *api)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+
+    atomic_store(&s->b_flush, true);
+    atomic_store(&s->b_eos, false);
+    mvc_api.hw_flush(s->p_hw);
+    return 0;
+}
+
+static int MvcHw_DequeueIn(mc_api *api, vlc_tick_t i_timeout)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+    int i_ms = i_timeout < 0 ? 2000 : (int)(i_timeout / 1000);
+
+    /* waits here (unlocked), not in queue_in, while the decoder's input is full */
+    return mvc_api.hw_wait_input(s->p_hw, i_ms) ? 0 : MC_API_INFO_TRYAGAIN;
+}
+
+static int MvcHw_QueueIn(mc_api *api, int i_index, const void *p_buf, size_t i_size,
+                         vlc_tick_t i_ts, bool b_config)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+    VLC_UNUSED(i_index);
+
+    /* input after a flush: the flush is over */
+    atomic_store(&s->b_flush, false);
+    if (!p_buf)
+        atomic_store(&s->b_eos, true);
+    else if (b_config)
+        mvc_api.hw_config(s->p_hw, p_buf, i_size);
+    else
+        mvc_api.hw_decode(s->p_hw, p_buf, i_size, i_ts);
+    return 0;
+}
+
+static int MvcHw_DequeueOut(mc_api *api, vlc_tick_t i_timeout)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+    vlc_tick_t i_waited = 0;
+    int i_idle = 0;
+
+    if (!s->b_conf_sent)
+    {
+        s->b_conf_sent = true;
+        return MC_API_INFO_OUTPUT_FORMAT_CHANGED;
+    }
+    for (;;)
+    {
+        if (atomic_exchange(&s->b_flush, false))
+            return MC_API_INFO_TRYAGAIN;
+        int64_t i_pts;
+        int i = mvc_api.hw_get_picture(s->p_hw, 100, &i_pts);
+        if (i >= 0)
+        {
+            s->pi_pts[i % 64] = i_pts;
+            return i;
+        }
+        /* draining: the pictures still in the decoder do not come out */
+        if (atomic_load(&s->b_eos) && ++i_idle >= 3)
+        {
+            atomic_store(&s->b_eos, false);
+            return MVC_HW_EOS_INDEX;
+        }
+        i_waited += VLC_TICK_FROM_MS(100);
+        if (i_timeout >= 0 && i_waited >= i_timeout)
+            return MC_API_INFO_TRYAGAIN;
+    }
+}
+
+static int MvcHw_GetOut(mc_api *api, int i_index, mc_api_out *p_out)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+
+    p_out->b_eos = false;
+    if (i_index == MC_API_INFO_OUTPUT_FORMAT_CHANGED)
+    {
+        p_out->type = MC_OUT_TYPE_CONF;
+        p_out->conf.video.width = s->i_width;
+        p_out->conf.video.height = s->i_height;
+        p_out->conf.video.stride = s->i_width;
+        p_out->conf.video.slice_height = s->i_height;
+        p_out->conf.video.pixel_format = 0;
+        p_out->conf.video.crop_left = 0;
+        p_out->conf.video.crop_top = 0;
+        p_out->conf.video.crop_right = s->i_width - 1;
+        p_out->conf.video.crop_bottom = s->i_height - 1;
+        return 1;
+    }
+    if (i_index < 0)
+        return 0;
+    p_out->type = MC_OUT_TYPE_BUF;
+    p_out->buf.p_ptr = NULL;
+    p_out->buf.i_size = 0;
+    if (i_index == MVC_HW_EOS_INDEX)
+    {
+        /* no picture (ts 0: dropped as a preroll one) */
+        p_out->b_eos = true;
+        p_out->buf.i_index = -1;
+        p_out->buf.i_ts = 0;
+        return 1;
+    }
+    p_out->buf.i_index = i_index;
+    p_out->buf.i_ts = s->pi_pts[i_index % 64];
+    return 1;
+}
+
+static int MvcHw_ReleaseOut(mc_api *api, int i_index, bool b_render)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+
+    if (i_index < 0 || i_index == MVC_HW_EOS_INDEX || !s->p_hw)
+        return 0;
+    if (b_render)
+        mvc_api.hw_present(s->p_hw, i_index, 0);
+    else
+        mvc_api.hw_discard(s->p_hw, i_index);
+    return 0;
+}
+
+static int MvcHw_ReleaseOutTs(mc_api *api, int i_index, int64_t i_ts_ns)
+{
+    struct mvc_hw_sys *s = MvcHwSys(api);
+
+    if (i_index < 0 || i_index == MVC_HW_EOS_INDEX || !s->p_hw)
+        return 0;
+    /* the video tunnel shows it at that time (CLOCK_MONOTONIC, as MediaCodec) */
+    return mvc_api.hw_present(s->p_hw, i_index, i_ts_ns) ? MC_API_ERROR : 0;
+}
+
+static int MvcHw_SetOutputSurface(mc_api *api, void *p_surface, void *p_jsurface)
+{
+    VLC_UNUSED(api); VLC_UNUSED(p_surface); VLC_UNUSED(p_jsurface);
+    return MC_API_ERROR;
+}
+
+static int MvcHw_Init(mc_api *api, unsigned i_width, unsigned i_height, bool b_fp)
+{
+    struct mvc_hw_sys *s = calloc(1, sizeof(*s));
+
+    if (!s)
+        return VLC_ENOMEM;
+    s->i_width = i_width;
+    s->i_height = i_height;
+    s->b_fp = b_fp;
+    atomic_init(&s->b_flush, false);
+    atomic_init(&s->b_eos, false);
+    api->p_sys = (mc_api_sys *)s;
+    api->clean = MvcHw_Clean;
+    api->configure = MvcHw_Configure;
+    api->start = MvcHw_Start;
+    api->stop = MvcHw_Stop;
+    api->flush = MvcHw_Flush;
+    api->dequeue_in = MvcHw_DequeueIn;
+    api->dequeue_out = MvcHw_DequeueOut;
+    api->queue_in = MvcHw_QueueIn;
+    api->get_out = MvcHw_GetOut;
+    api->release_out = MvcHw_ReleaseOut;
+    api->release_out_ts = MvcHw_ReleaseOutTs;
+    api->set_output_surface = MvcHw_SetOutputSurface;
+    return VLC_SUCCESS;
+}
+
 /* CFG_PREFIX "mvc" */
 #define MVC_MODE_AUTO 0
 #define MVC_MODE_2D 1
@@ -337,6 +597,8 @@ struct decoder_sys_t
     bool            b_drained;
     bool            b_adaptive;
     int             i_decode_flags;
+    /* the MediaCodec api (NDK / JNI), back from the hardware MVC one */
