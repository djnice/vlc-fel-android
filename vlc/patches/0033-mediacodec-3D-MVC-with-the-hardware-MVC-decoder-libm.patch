         } video;
         struct {
             date_t i_end_date;
@@ -402,6 +667,7 @@ static void DoviInfo(decoder_t *, const block_t *);
 static void DoviInfoShown(decoder_t *, unsigned, int64_t);
 static char *DoviInfoDir(void);
 static void MvcProbe(decoder_t *, const block_t *);
+static void MvcHwSwitch(decoder_t *, bool);
 static void Video_OnFlush(decoder_t *);
 static int Video_ProcessOutput(decoder_t *, mc_api_out *, picture_t **,
                                block_t **);
@@ -459,6 +725,18 @@ static void RemoveInflightPictures(decoder_t *);
     "automatic (when the display supports 3D), 2D (the base view) or 3D."
 static const int pi_mvc_values[] = { MVC_MODE_AUTO, MVC_MODE_2D, MVC_MODE_3D };
 static const char *const ppsz_mvc_names[] = { N_("Automatic"), N_("2D"), N_("3D") };
+#define MEDIACODEC_MVC_HW_TEXT "3D MVC decoder"
