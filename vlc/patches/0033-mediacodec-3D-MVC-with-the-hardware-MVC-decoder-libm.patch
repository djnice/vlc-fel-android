+/*
+ * The api of the stopped decoder: to the hardware MVC one (b_hw), or back to
+ * MediaCodec when that does not start (3D then through the software path).
+ */
+static void MvcHwSwitch(decoder_t *p_dec, bool b_hw)
+{
+    decoder_sys_t *p_sys = p_dec->p_sys;
+    mc_api *api = &p_sys->api;
+    vlc_object_t *p_obj = api->p_obj;
+    const char *psz_mime = api->psz_mime;
+    enum es_format_category_e i_cat = api->i_cat;
+    vlc_fourcc_t i_codec = api->i_codec;
+
+    api->clean(api);
+    memset(api, 0, sizeof(*api));
+    api->p_obj = p_obj;
+    api->psz_mime = psz_mime;
+    api->i_cat = i_cat;
+    api->i_codec = i_codec;
+    if (b_hw && MvcHw_Init(api, p_sys->video.i_mvc_width, p_sys->video.i_mvc_height,
+                           p_sys->video.b_mvc_fp) == VLC_SUCCESS)
+    {
+        api->configure(api, p_sys->video.i_profile);
+        p_sys->video.b_mvc_hw = true;
+        return;
+    }
+    p_sys->video.b_mvc_hw = false;
+    p_sys->video.b_mvc_hw_want = false;
+    if (p_sys->pf_init(api) != 0 || api->configure(api, p_sys->video.i_profile) != 0)
+    {
+        msg_Err(p_dec, "MediaCodec back: failed");
+        return;
+    }
+    if (p_sys->video.b_mvc_fp && !p_sys->video.p_mvc && mvc_api.available())
+    {
