From e0edb065b9ddd6e746591873b548a40ea43ef360 Mon Sep 17 00:00:00 2001
From: Steve Lhomme <robux4@ycbcr.xyz>
Date: Fri, 25 Sep 2026 16:23:29 +0200
Subject: [PATCH] demux: mkv: allow infinite elements in finite parent

The stack overflow from #29578 is no longer present in that sample with
all the libebml and recent demuxer changes. We can allow this type of file again.

Fixes #30147
Fixes #30172

(cherry picked from commit fbc9f55971c338d0d06de1d2fc60646839ec698e)
Signed-off-by: Steve Lhomme <robux4@ycbcr.xyz>
(cherry picked from commit a438aba4927380c3593e628618181e0c91012bc6)

Message-Id: <20261103-vlc30x-a438aba492@djnice>
---
 modules/demux/mkv/Ebml_parser.cpp | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/modules/demux/mkv/Ebml_parser.cpp b/modules/demux/mkv/Ebml_parser.cpp
index e121b617a1..d3f8b8f76d 100644
--- a/modules/demux/mkv/Ebml_parser.cpp
+++ b/modules/demux/mkv/Ebml_parser.cpp
@@ -160,11 +160,8 @@ EbmlElement *EbmlParser::Get( bool allow_overshoot )
             }
             if( !ret->IsFiniteSize() )
             {
-                msg_Err( p_demux, "Infinite EBML element %s at %" PRIu64 " inside finite parent",
+                msg_Dbg( p_demux, "Infinite EBML element %s at %" PRIu64 " inside finite parent",
                          EBML_NAME(ret), ret->GetElementPosition() );
-                delete ret;
-                m_el[mi_level] = NULL;
-                return NULL;
             }
         }
         return ret;
-- 
