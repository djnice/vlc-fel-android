         if (sharedPreferences == null || key == null) return
         when (key) {
-            KEY_PREFERRED_RESOLUTION -> {
+            KEY_PREFERRED_RESOLUTION, "mvc_hardware" -> {
                 launch {
                     VLCInstance.restart()
                     restartMediaPlayer()
