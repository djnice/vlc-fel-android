diff --git a/application/vlc-android/src/org/videolan/vlc/util/DuneDesktopMode.kt b/application/vlc-android/src/org/videolan/vlc/util/DuneDesktopMode.kt
index 7d790da..6943a36 100644
--- a/application/vlc-android/src/org/videolan/vlc/util/DuneDesktopMode.kt
+++ b/application/vlc-android/src/org/videolan/vlc/util/DuneDesktopMode.kt
@@ -68,12 +68,25 @@ object DuneDesktopMode {
                 beforeFrac = bootenv(s, FRAC)
             }
             delay(AFR_WAIT_MS)
-            val v = runCatching { service.mediaplayer.getSelectedVideoTrack() }.getOrNull() ?: return@launch
-            if (v.getFrameRateNum() <= 0 || v.getFrameRateDen() <= 0) return@launch
-            matchRate(s, v.getFrameRateNum().toDouble() / v.getFrameRateDen())
+            val v = runCatching { service.mediaplayer.getSelectedVideoTrack() }.getOrNull()
+            if (v != null && v.getFrameRateNum() > 0 && v.getFrameRateDen() > 0) {
+                matchRate(s, v.getFrameRateNum().toDouble() / v.getFrameRateDen())
+            } else if (mvcFramePacking()) {
+                // a Blu-ray 3D's .ssif / m2ts tells VLC no rate, and frame packing needs its 24 Hz mode
+                matchRate(s, 24000.0 / 1001)
+            }
         }
     }
 
+    /** the hardware MVC decoder plays frame packed (the mvc3d module's status; old modules have none) */
+    private fun mvcFramePacking() = runCatching {
+        java.io.RandomAccessFile("/dev/mvc3dhw", "r").use { f ->
+            val b = ByteArray(48)
+            val n = f.read(b)
+            n > 0 && String(b, 0, n).contains("armed=1")
+        }
+    }.getOrDefault(false)
+
     private fun matchRate(s: Any, fps: Double) {
         if (fps < 23.0 || fps > 61.0) return
         runCatching {
