 5 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/application/resources/src/main/java/org/videolan/resources/VLCOptions.kt b/application/resources/src/main/java/org/videolan/resources/VLCOptions.kt
index 7599ef8..37ee504 100644
--- a/application/resources/src/main/java/org/videolan/resources/VLCOptions.kt
+++ b/application/resources/src/main/java/org/videolan/resources/VLCOptions.kt
@@ -77,6 +77,15 @@ import java.io.File
 import java.util.Collections
 
 object VLCOptions {
+    /** VLC FEL: the S928X (S5), the box whose 3D MVC can be decoded in software too (the S905X4: hardware only) */
+    val isS928x: Boolean by lazy {
+        try {
+            File("/proc/device-tree/compatible").readText().replace('\u0000', ' ').split(' ', ',').any { it.trim() == "s5" }
+        } catch (e: Exception) {
+            false
+        }
+    }
+
     private const val TAG = "VLC/VLCConfig"
 
     private const val AOUT_AAUDIO = 0
@@ -212,6 +221,8 @@ object VLCOptions {
             }
             options.add("--sout-keep")
 
+            // VLC FEL: the 3D MVC decoder of the S928X, hardware or software (the setting mvc_hardware)
+            if (isS928x) options.add("--mediacodec-mvc-hw=" + if (pref.getBoolean("mvc_hardware", false)) "1" else "0")
             val customOptions = pref.getString(KEY_CUSTOM_LIBVLC_OPTIONS, null)
             if (!customOptions.isNullOrEmpty()) {
                 val optionsArray = customOptions.split("\\r?\\n".toRegex()).toTypedArray()
